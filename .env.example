# ─────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill in the values.
#  Step-by-step guide: docs/FIREBASE_SETUP.md
#  Restart `npm run dev` after changing anything in .env.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
# Display name used in the header, page titles and link previews.
VITE_APP_NAME=Tessera

# Public address the QR codes point to, WITHOUT a trailing slash.
# Leave empty to use whatever address the app is opened from.
# Examples:
#   https://card.yourdomain.com          (subdomain — recommended)
#   https://yourdomain.com/card          (sub-path — also set VITE_BASE_PATH=/card/)
VITE_PUBLIC_BASE_URL=

# Only needed when serving the app from a sub-path, e.g. /card/
# Leave empty to serve from the root of the domain.
VITE_BASE_PATH=

# ── Firebase ─────────────────────────────────────────────────
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
